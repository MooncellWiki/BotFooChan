ENVIRONMENT=dev
DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=8086
LOG_LEVEL=INFO

FASTAPI_RELOAD=false

NICKNAME=[]
SUPERUSERS=[]
COMMAND_START=["/",""]
COMMAND_SEP=["."," "]
PLUGINS='[
  "nonebot_plugin_sentry",
  "nonebot_plugin_alconna",
  "nonebot_plugin_apscheduler",
  "nonebot_plugin_filehost",
  "nonebot_plugin_shorturl",
  "nonebot_plugin_treehelp"
]'
PLUGIN_DIRS=["src/plugins"]

# adapters config
QQ_BOTS=[]
RED_BOTS=[]
FEISHU_BOTS=[]
SATORI_CLIENTS=[]
ONEBOT_WS_URLS=[]
ONEBOT_API_ROOTS={}
ONEBOT_SECRET
ONEBOT_ACCESS_TOKEN

# plugins config
## nonebot-plugin-apscheduler
APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.timezone":"Asia/Shanghai"}

# nonebot-plugin-sentry
# leave sentry_dsn empty to disable sentry bug trace
# See Also: https://sentry.io/
SENTRY_DSN
SENTRY_DEFAULT_INTEGRATIONS=true
SENTRY_AUTO_ENABLING_INTEGRATIONS=true
SENTRY_ENABLE_TRACING=true
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILES_SAMPLE_RATE=0.5

## nonebot-plugin-datastore
# 已不再使用，仅保留用于从旧版 nonebot-bison 迁移订阅数据（见 src/plugins/bison/config/db_migration.py）
DATASTORE_DATA_DIR=./data

## nonebot-plugin-localstore
LOCALSTORE_CACHE_DIR=./data/cache
LOCALSTORE_DATA_DIR=./data
LOCALSTORE_CONFIG_DIR=./data/config

## nonebot-plugin-orm
# 订阅数据库默认为 ${LOCALSTORE_DATA_DIR}/nonebot_plugin_orm/db.sqlite3
# 需要换库时设置 SQLALCHEMY_DATABASE_URL
SQLALCHEMY_ECHO=false
# 启动时校验数据库是否与迁移脚本一致，不一致则拒绝启动（非交互终端下不会自动改表）
# 改动 src/plugins/bison/config/db_model.py 后需要生成迁移脚本，见 src/plugins/bison/migrations/
ALEMBIC_STARTUP_CHECK=true

## nonebot-plugin-treehelp
TREEHELP_IGNORED_PLUGINS=["Bison","Sentry日志监控"]

## bison（src/plugins/bison）
BISON_FILTER_LOG
BISON_USE_PIC
BISON_USE_PIC_MERGE
BISON_USE_BROWSER=false

## aliyun config
CDN_DOMAINS

## nbnhhsh config
NBNHHSH_API_ENDPOINT

## filehost config
FILEHOST_HOST_OVERRIDE

## shorturl config
SHORTURL_HOST
SHORTURL_ENDPOINT

## llm central config
## providers: 服务商注册表（base_url + api_key，Key 只配一次）
## models: 模型注册表（别名 -> "服务商:模型名"）
## 两者均可加 api_type 覆写协议：responses / chat / anthropic
## 缺省时 DeepSeek 官方支持 Responses 的模型走 responses（内置联网搜索），其余走 chat
## anthropic 走 Anthropic Messages 兼容协议（DeepSeek 官方自动补 /anthropic 路径），
## 不支持联网搜索、图片输入与 frequency/presence_penalty，且未设 max_tokens 时默认 4096
LLM__PROVIDERS={}
LLM__MODELS={}

## deepseek config
DEEPSEEK__TIMEOUT=600

## zssm config (模型引用为 LLM__MODELS 中的别名)
ZSSM_AI_TEXT_MODEL
ZSSM_AI_VL_MODEL
ZSSM_AI_CHECK_MODEL

## playwright provider config
## 配置后连远程 firefox（浏览器在独立的 playwright 容器里），不再本地启动/下载浏览器
## 只有清空该项回到本地模式时，BROWSER_INSTALL 才生效（默认 true，见 .env.dev）
BROWSER_WS_ENDPOINT=ws://playwright:3000/
BROWSER_PROXY

## what2eat config
WHAT2EAT__MODEL

## htmlrender config
## 远程 Playwright（WS）：浏览器跑在独立的 playwright 容器里，本地只渲染模板/截图
## 0.8 起用 render 命名空间，平铺的 RENDER_BACKEND / RENDER_PLAYWRIGHT 会让启动直接报错
RENDER__PROVIDER=playwright
RENDER__PROVIDER_CONFIG={"connect_ws":{"endpoint":"ws://playwright:3000/"},"skip_browser_install":true}

## torappu config
TORAPPU_API_URL=https://torappu.prts.wiki
TORAPPU_AUTH_TOKEN
