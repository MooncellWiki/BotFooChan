ENVIRONMENT=dev
DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=8086
LOG_LEVEL=INFO

FASTAPI_RELOAD=false

NICKNAME=[]
SUPERUSERS=[]
COMMAND_START=["/",""]
COMMAND_SEP=["."," "]
## nonebot_plugin_alconna 不用列：chat_history provider 等会先行 require，再列一遍
## load_all_plugins 会报 Plugin already exists，整个 bot 起不来
PLUGINS='[
  "nonebot_plugin_sentry",
  "nonebot_plugin_apscheduler",
  "nonebot_plugin_filehost",
  "nonebot_plugin_shorturl",
  "nonebot_plugin_treehelp"
]'
PLUGIN_DIRS=["src/plugins"]

# adapters config
QQ_BOTS=[]
RED_BOTS=[]
FEISHU_BOTS=[]
SATORI_CLIENTS=[]
ONEBOT_WS_URLS=[]
ONEBOT_API_ROOTS={}
ONEBOT_SECRET
ONEBOT_ACCESS_TOKEN
## GitHub：GITHUB_APPS 里放一个 GitHub App（webhook、/install 都靠它，必须带
## client_id / client_secret 供 /auth 使用），可以再加一个 OAuth App，作为未授权用户
## 查看公开仓库时的兜底。没有 GitHub App 时 GitHub 插件只打一条警告、不加载
## webhook 地址：/github/webhooks/<app_id>；OAuth 回调地址：/github/auth
GITHUB_APPS=[]
## 渲染 Issue/PR 要用 GitHub 生成好的 body_html，必须是 full+json
GITHUB_ACCEPT_FORMAT=full+json
GITHUB_PREVIEWS=["starfox"]

# plugins config
## nonebot-plugin-apscheduler
APSCHEDULER_AUTOSTART=true
APSCHEDULER_CONFIG={"apscheduler.timezone":"Asia/Shanghai"}

# nonebot-plugin-sentry
# leave sentry_dsn empty to disable sentry bug trace
# See Also: https://sentry.io/
SENTRY_DSN
SENTRY_DEFAULT_INTEGRATIONS=true
SENTRY_AUTO_ENABLING_INTEGRATIONS=true
SENTRY_ENABLE_TRACING=true
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILES_SAMPLE_RATE=0.5

## nonebot-plugin-datastore
# 已不再使用，仅保留用于从旧版 nonebot-bison 迁移订阅数据（见 src/plugins/bison/config/db_migration.py）
DATASTORE_DATA_DIR=./data

## nonebot-plugin-localstore
LOCALSTORE_CACHE_DIR=./data/cache
LOCALSTORE_DATA_DIR=./data
LOCALSTORE_CONFIG_DIR=./data/config

## nonebot-plugin-orm
# 订阅数据库默认为 ${LOCALSTORE_DATA_DIR}/nonebot_plugin_orm/db.sqlite3
# 需要换库时设置 SQLALCHEMY_DATABASE_URL
SQLALCHEMY_ECHO=false
# 启动时校验数据库是否与迁移脚本一致，不一致则拒绝启动（非交互终端下不会自动改表）
# 改动 src/plugins/bison/config/db_model.py 后需要生成迁移脚本，见 src/plugins/bison/migrations/
ALEMBIC_STARTUP_CHECK=true

## nonebot-plugin-treehelp
TREEHELP_IGNORED_PLUGINS=[]

## bison（src/plugins/bison）
BISON_FILTER_LOG
BISON_USE_PIC
BISON_USE_PIC_MERGE
BISON_USE_BROWSER=false

## aliyun config
CDN_DOMAINS

## nbnhhsh config
NBNHHSH_API_ENDPOINT

## filehost config
FILEHOST_HOST_OVERRIDE

## shorturl config
SHORTURL_HOST
SHORTURL_ENDPOINT

## llm central config
## providers: 服务商注册表（base_url + api_key，Key 只配一次）
## models: 模型注册表（别名 -> "服务商:模型名"）
## 两者均可加 api_type 覆写协议：responses / chat / anthropic
## 缺省时 DeepSeek 官方的 deepseek-flash（即 V4.1-Flash）与 deepseek-v4-pro 走 responses，
## 其余走 chat；anthropic 走 Anthropic Messages 兼容协议（官方自动补 /anthropic 路径），
## 不支持 frequency/presence_penalty，且未设 max_tokens 时默认 4096
## 内置联网搜索（CHAT__WEB_SEARCH / ZSSM_AI_WEB_SEARCH）只有 anthropic 协议能用，
## responses 会把工具原样收下却从不执行，配了也是白配
## 两者还可加 vision 覆写「模型是否接受图片输入」，缺省时只认 DeepSeek 官方的 Flash 系
LLM__PROVIDERS={}
LLM__MODELS={}

## zssm config (模型引用为 LLM__MODELS 中的别名)
## 图片直接交给模型看，要选支持图片输入的（DeepSeek 官方只有 Flash 系）
ZSSM_AI_MODEL
## 联网搜索，与 CHAT__WEB_SEARCH 一样只有 anthropic 协议能用
## 搜到的来源会单独放在合并转发里的一条
ZSSM_AI_WEB_SEARCH=false
## 预先附带的、被解释消息之前的聊天记录条数（更早的由模型用工具自己翻，0 为不附带）
ZSSM_CONTEXT_SIZE=8

## playwright provider config
## 配置后连远程 firefox（浏览器在独立的 playwright 容器里），不再本地启动/下载浏览器
## 只有清空该项回到本地模式时，BROWSER_INSTALL 才生效（默认 true，见 .env.dev）
BROWSER_WS_ENDPOINT=ws://playwright:3000/
BROWSER_PROXY

## what2eat config
WHAT2EAT__MODEL

## chat config（通用对话：被 @ 或被回复时接话）
## 不配 CHAT__MODEL 则插件不响应；CHAT__NAME 留空时取 NICKNAME 的第一个
CHAT__MODEL
CHAT__NAME
CHAT__PROMPT
## 拼进提示词的最近消息条数（更早的由模型用工具自己翻）
CHAT__CONTEXT_SIZE=25
## 单次回答的最大 token 数；anthropic 协议不设时只有 4096，长回答会被截断
CHAT__MAX_TOKENS
## 联网搜索（只有 anthropic 协议能用），搜过的回答会连来源一起排版
CHAT__WEB_SEARCH=false
## 单次最多交给模型几张图片（模型支持看图时生效），0 为不看图
CHAT__MAX_IMAGES=4
## 长回答渲染成图片（绑定了官方机器人的群走原生 markdown）；关闭时发纯文本
CHAT__RENDER_IMAGE=true
## 长回答排版时附上思维链
CHAT__SEND_THINKING=false
## 不接话的账号 id（群里其它机器人），免得两边你一句我一句聊起来
## 本进程自己连着的账号会自动忽略，不用写在这里
CHAT__BLACKLIST=[]

## chat_history provider config（各插件共用的会话消息缓冲）
## 每个会话在内存里保留的条数，也是模型用工具最多能往前翻到的范围；单条进提示词的截断长度
CHAT_HISTORY__SIZE=200
CHAT_HISTORY__MAX_TEXT_LENGTH=300

## user_memory provider config（按人建档的长期记忆）
## 档案超过 MAX_CHARS 字时用 MODEL 压缩到 TARGET_CHARS；不配 MODEL 则退化为按行截断
USER_MEMORY__MODEL
USER_MEMORY__MAX_CHARS=1500
USER_MEMORY__TARGET_CHARS=900

## htmlrender config
## 远程 Playwright（WS）：浏览器跑在独立的 playwright 容器里，本地只渲染模板/截图
## 0.8 起用 render 命名空间，平铺的 RENDER_BACKEND / RENDER_PLAYWRIGHT 会让启动直接报错
RENDER__PROVIDER=playwright
RENDER__PROVIDER_CONFIG={"connect_ws":{"endpoint":"ws://playwright:3000/"},"skip_browser_install":true}

## github config（src/plugins/github，搬自 QQ-GitHub-Bot）
## Issue/PR 截图的配色：light / dark
GITHUB_THEME=light

## nonebot-plugin-status（src/plugins/status）
## 插件自带的命令不认 / 前缀，关掉后由 src/plugins/status 重新注册；仅超级用户可用
SERVER_STATUS_ENABLED=false
SERVER_STATUS_TEMPLATE="
Runtime: {{ runtime | relative_time | humanize_delta }}
CPU: {{ '%02d' % cpu_usage }}%
Memory: {{ '%02d' % memory_usage.percent }}%
"

## torappu config
TORAPPU_API_URL=https://torappu.prts.wiki
TORAPPU_AUTH_TOKEN
