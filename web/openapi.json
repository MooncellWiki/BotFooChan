{
  "openapi": "3.1.0",
  "info": {
    "title": "BotFooChan WebUI",
    "version": "1"
  },
  "servers": [
    {
      "url": "/admin/api"
    }
  ],
  "paths": {
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "退出登录",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "overview"
        ],
        "summary": "Get Me",
        "description": "当前登录的管理员",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/overview": {
      "get": {
        "tags": [
          "overview"
        ],
        "summary": "Get Overview",
        "description": "运行状态概览",
        "operationId": "get_overview",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BotInfo": {
        "properties": {
          "self_id": {
            "type": "string",
            "title": "Self Id"
          },
          "adapter": {
            "type": "string",
            "title": "Adapter"
          },
          "connected_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connected At"
          }
        },
        "type": "object",
        "required": [
          "self_id",
          "adapter",
          "connected_at"
        ],
        "title": "BotInfo"
      },
      "Component": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "off"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "Component"
      },
      "Me": {
        "properties": {
          "login": {
            "type": "string",
            "title": "Login"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "avatar_url": {
            "type": "string",
            "title": "Avatar Url"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "login",
          "name",
          "avatar_url",
          "environment"
        ],
        "title": "Me"
      },
      "Ok": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          }
        },
        "type": "object",
        "title": "Ok"
      },
      "Overview": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "python_version": {
            "type": "string",
            "title": "Python Version"
          },
          "nonebot_version": {
            "type": "string",
            "title": "Nonebot Version"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "cpu_percent": {
            "type": "number",
            "title": "Cpu Percent"
          },
          "memory_percent": {
            "type": "number",
            "title": "Memory Percent"
          },
          "process_memory": {
            "type": "integer",
            "title": "Process Memory"
          },
          "adapters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Adapters"
          },
          "plugin_count": {
            "type": "integer",
            "title": "Plugin Count"
          },
          "bots": {
            "items": {
              "$ref": "#/components/schemas/BotInfo"
            },
            "type": "array",
            "title": "Bots"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "python_version",
          "nonebot_version",
          "started_at",
          "cpu_percent",
          "memory_percent",
          "process_memory",
          "adapters",
          "plugin_count",
          "bots",
          "components"
        ],
        "title": "Overview"
      }
    }
  }
}
