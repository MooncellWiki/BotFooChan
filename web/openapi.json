                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminIn": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 39,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Login"
          },
          "note": {
            "type": "string",
            "maxLength": 256,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "login"
        ],
        "title": "AdminIn"
      },
      "AdminOut": {
        "properties": {
          "login": {
            "type": "string",
            "title": "Login"
          },
          "source": {
            "type": "string",
            "enum": [
              "env",
              "database"
            ],
            "title": "Source"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          },
          "added_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added By"
          },
          "added_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "login",
          "source"
        ],
        "title": "AdminOut"
      },
      "AuditEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "entity": {
            "type": "string",
            "title": "Entity"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "at",
          "actor",
          "entity",
          "action",
          "detail"
        ],
        "title": "AuditEntry"
      },
      "Body_put_prompt": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "Body_put_prompt"
      },
      "BotInfo": {
        "properties": {
          "self_id": {
            "type": "string",
            "title": "Self Id"
          },
          "adapter": {
